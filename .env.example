###############################################################################
# PolyTail BTC 15m — 环境变量模板
#
#   cp .env.example .env      # 本地运行
#
# 非敏感项也可以写在 config.toml 的 [GENERAL] / [LOG] 里；
# 优先级：代码默认 < config.toml < .env.docker < .env < 进程环境变量
#          < 网页「参数」页的运行时覆盖（存数据库）
#
# 本文件会被 .gitignore 忽略，不要提交真实密钥。
###############################################################################

# ── 运行模式 ────────────────────────────────────────────────────────────────
# paper = 纸面交易：用真实行情模拟成交，记录全部数据，不碰钱包
# live  = 实盘：向 CLOB 发送 GTD/FAK 买单
# 默认 15m 实盘、5m 纸面（可在网页「参数」页按策略切换并持久化）
TRADING_MODE=live

# ── CLOB 凭证（实盘必填）────────────────────────────────────────────────────
# 方式 A：直接使用 L2 API Key（三个都要填）
API_KEY=
API_SECRET=
API_PASSPHRASE=

# 方式 B：私钥，程序启动时自动派生 L2 凭证（仍可同时填 A）
WALLET_PRIVATE_KEY=
# 0 = EOA；1 = POLY_PROXY（邮箱/Magic 登录）；2 = GNOSIS_SAFE
SIGNATURE_TYPE=0
# SIG_TYPE=1/2 必填：真正持有 USDC 的代理/Safe 地址
# 漏填会被 CLOB 以 "maker address not allowed" 拒绝
FUNDER_ADDRESS=

GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_HOST=https://clob.polymarket.com

# ── 要运行哪些策略 ──────────────────────────────────────────────────────────
ASSET=BTC
ENABLED_15M=true
ENABLED_5M=true

# ── 15m 策略（文档推荐：60 秒 / 0.90 / 10 秒 / 0.94）──────────────────────
ENTRY_WINDOW_SEC=60
ENTRY_THRESHOLD=0.90
CONFIRM_SEC=10
MAX_ENTRY_PRICE=0.94
MIN_ENTRY_PRICE=0
STAKE_USD=10                   # 仅回测口径；实盘按下单股数
ENTRY_SHARES=5                 # 实盘每笔股数（GTD 最少 5 股）
REARM_AFTER_FAILED_CONFIRM=false

# ── 5m 策略（实盘 + Agent 调优起点：30 秒 / 0.90 / 无确认 / 0.92）──────────
# 留空 = 继承上面的 TRADING_MODE
TRADING_MODE_5M=paper
ENTRY_WINDOW_SEC_5M=30
ENTRY_THRESHOLD_5M=0.90
CONFIRM_SEC_5M=0
MAX_ENTRY_PRICE_5M=0.92
MIN_ENTRY_PRICE_5M=0
STAKE_USD_5M=5                 # 仅回测口径
ENTRY_SHARES_5M=5
REARM_AFTER_FAILED_CONFIRM_5M=false

# ── 执行 ────────────────────────────────────────────────────────────────────
# 信号价来源：mid（与回测一致）/ last / ask
SIGNAL_PRICE_SOURCE=mid
# 下单方式：gtd = 先挂限价买单（maker，费率 0），未成交可回退 FAK；fak = 直接吃单
ENTRY_ORDER_TYPE=gtd
GTD_FILL_TIMEOUT_S=3
GTD_POST_ONLY=true
ENTRY_FALLBACK_FAK=true
MAKER_FEE_RATE=0
# FAK 限价 = 信号价 + 该值
EXEC_SLIPPAGE=0.01
EXEC_LIMIT_MAX=0.99
# 入场瞬间 (ask-bid) 超过该值则放弃；0 = 关闭
MAX_SPREAD_AT_ENTRY=0.06
# 限价内可用深度低于该值则放弃；0 = 关闭
MIN_BOOK_DEPTH_USD=0
# fee = 份额 × 费率 × p × (1-p)；Crypto 类目 0.07
TAKER_FEE_RATE=0.07
# 是否用 /fee-rate 覆盖上面的费率（默认关闭，见 README「费用口径」）
FEE_RATE_AUTODETECT=false
USE_MARKET_WS=true
POLL_INTERVAL_MS=1000
ENTRY_POLL_INTERVAL_MS=250
# 采集/入场窗口之前的「仅面板显示」轮询间隔
DISPLAY_POLL_INTERVAL_MS=5000

# ── 风控 ────────────────────────────────────────────────────────────────────
DAILY_LOSS_LIMIT_USD=50
MAX_CONSEC_LOSSES=3
PAUSE_MINUTES_AFTER_STREAK=60
MIN_WALLET_BALANCE_USD=15
RISK_RESERVE_USD=2
SETTLE_TIMEOUT_S=3600
RESOLUTION_POLL_S=15

# ── 纸面交易 ────────────────────────────────────────────────────────────────
PAPER_START_BALANCE=1000
# 没有订单簿时使用的滑点（概率点）
PAPER_SLIPPAGE=0.005
PAPER_USE_BOOK=true

# ── 数据目录 ────────────────────────────────────────────────────────────────
# 留空 = <项目根>/data（SQLite、采集数据、日志都在这里）
DATA_DIR=
# 研究输出目录；留空 = <DATA_DIR>/research
RESEARCH_OUTPUT_DIR=

# ── 实盘数据采集（供 Agent 调参）────────────────────────────────────────────
DATA_COLLECT_ENABLED=true
COLLECT_SEC=300

# ── 面板 ────────────────────────────────────────────────────────────────────
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8013
WEB_USERNAME=admin
# 必填：所有页面都要求登录；不设置则面板无法进入
WEB_PASSWORD=
WEB_SESSION_TTL_S=604800

# ── 研究 / Agent ────────────────────────────────────────────────────────────
# 历史数据集根目录；留空自动探测同级 predicttick/data/dataset
DATASET_ROOT=
# Agent 使用的模型与预算
AGENT_MODEL=claude-opus-5-5
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOKENS=16000
AGENT_MAX_BACKTESTS=40
ANTHROPIC_API_KEY=

# ── 日志 ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
HEARTBEAT_S=30
